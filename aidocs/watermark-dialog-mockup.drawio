<mxfile host="Electron" version="29.6.6">
  <diagram name="Watermark" id="watermark-dialog">
    <mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1"
                  connect="0" arrows="0" fold="0" page="1" pageScale="1"
                  pageWidth="800" pageHeight="520" background="#E5E5E5" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Window outer frame with shadow -->
        <mxCell id="window-frame" parent="1" vertex="1" value=""
                style="rounded=1;arcSize=4;fillColor=#ECECEC;strokeColor=#B0B0B0;shadow=1;">
          <mxGeometry x="40" y="40" width="720" height="440" as="geometry"/>
        </mxCell>

        <!-- Title bar background (slightly different shade) -->
        <mxCell id="titlebar-bg" parent="1" vertex="1" value=""
                style="rounded=0;fillColor=#E0E0E0;strokeColor=none;">
          <mxGeometry x="41" y="42" width="718" height="44" as="geometry"/>
        </mxCell>

        <!-- Traffic lights -->
        <mxCell id="tl-close" parent="1" vertex="1" value=""
